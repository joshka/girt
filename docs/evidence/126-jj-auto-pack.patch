+/// Runs Git's automatic pack-refs maintenance task, as Git porcelain does after
+/// writing references.
+///
+/// Packing keeps ref enumeration cheap after jj writes many refs, such as
+/// `refs/jj/keep/*`. Like Git, failures (for example, another process holding
+/// `packed-refs.lock`) are logged and otherwise ignored.
+pub fn auto_pack_refs(store: &Store) {
+    let Ok(git_backend) = get_git_backend(store) else {
+        return;
+    };
+    let repo = git_backend.git_repo();
+    let result = match repo.objects(girt::PackLimits::trusted()) {
+        Ok(objects) => repo
+            .auto_pack_references(&objects)
+            .map_err(|err| err.to_string()),
+        Err(err) => Err(err.to_string()),
+    };
+    if let Err(err) = result {
+        tracing::debug!(%err, "skipped packing Git refs");
+    }
+}
