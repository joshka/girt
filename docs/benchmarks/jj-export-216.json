    "source_patch": "diff --git a/src/refs/store.rs b/src/refs/store.rs\nindex f1d16e7ee7..9bde073392 100644\n--- a/src/refs/store.rs\n+++ b/src/refs/store.rs\n@@ -1262,16 +1262,25 @@ fn publish_replacement(&self, bytes: &[u8], sync: bool) -> Result<(), ReferenceE\n         self.check_owned()?;\n         #[expect(clippy::unwrap_used, reason = \"lock destinations lie below a root\")]\n         let parent = self.destination.parent().unwrap();\n+        let permissions = self.identity.permissions();\n         let mut temporary = tempfile::Builder::new()\n             .prefix(\".girt-packed-\")\n+            .permissions(permissions.clone())\n             .tempfile_in(parent)\n             .map_err(|source| io_error(parent, source))?;\n-        // Match ordinary lock creation permissions, including the process umask.\n-        let permissions = self.identity.permissions();\n-        temporary\n+        // Creation applies the current umask. Correct any mismatch with the captured\n+        // lock mode, without changing metadata when creation already matched it.\n+        let actual_permissions = temporary\n             .as_file()\n-            .set_permissions(permissions)\n-            .map_err(|source| io_error(temporary.path(), source))?;\n+            .metadata()\n+            .map_err(|source| io_error(temporary.path(), source))?\n+            .permissions();\n+        if actual_permissions != permissions {\n+            temporary\n+                .as_file()\n+                .set_permissions(permissions)\n+                .map_err(|source| io_error(temporary.path(), source))?;\n+        }\n         temporary\n             .write_all(bytes)\n             .map_err(|source| io_error(temporary.path(), source))?;\n",
