+    let maintained = repo
+        .run_maintenance(
+            &mut GcLock,
+            &policy,
+            girt::retention::RepackLimits::trusted(),
+            &cancel,
+        )
         .map_err(|err| GitGcError::Maintenance(err.into()))?;
-    let pruned = repo
