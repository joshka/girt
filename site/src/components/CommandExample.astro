---
interface Props {
  command: string;
  api: string;
  apiPath: string;
  git: string;
  note?: string;
}

const { command, api, apiPath, git, note } = Astro.props;
---

<div class="command-example">
  <div class="command-example__body"><slot /></div>
  <aside class="command-reference not-content" aria-label={`Command reference: ${command}`}>
    <div class="command-reference__title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6v12m12-12v2a4 4 0 0 1-4 4h-4a4 4 0 0 0-4 4" />
        <circle cx="6" cy="4" r="2" /><circle cx="18" cy="4" r="2" />
        <circle cx="6" cy="20" r="2" />
      </svg>
      <span>Command reference</span>
    </div>
    <dl>
      <div>
        <dt>girt command</dt>
        <dd><code>{command}</code></dd>
      </div>
      <div>
        <dt>Library API</dt>
        <dd><a href={`https://docs.rs/girt/latest/girt/${apiPath}`}><code>{api}</code><span aria-hidden="true"> ↗</span></a></dd>
      </div>
      <div>
        <dt>Git equivalent</dt>
        <dd><code>{git}</code></dd>
      </div>
    </dl>
    {note && <p>{note}</p>}
  </aside>
</div>

<style>
  .command-example {
    margin-block: 1.5rem;
  }

  .command-example__body {
    min-width: 0;
  }

  .command-example__body > :global(:first-child) {
    margin-top: 0;
  }

  .command-reference {
    align-self: start;
    min-width: 0;
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    background: var(--sl-color-gray-6);
    color: var(--girt-text-secondary);
  }

  .command-reference__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: 600 0.6875rem/1.5 var(--__sl-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  svg {
    flex: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  dl {
    margin: 1rem 0 0;
  }

  dl > div + div {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  dt {
    margin-bottom: 0.35rem;
    color: var(--sl-color-gray-3);
    font: 0.6875rem/1.5 var(--__sl-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--sl-color-text);
    font-size: 0.8125rem;
  }

  code {
    padding: 0;
    background: none;
    font: 0.75rem/1.7 var(--__sl-font-mono);
    overflow-wrap: anywhere;
    white-space: normal;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--girt-underline);
    text-underline-offset: 4px;
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 4px;
  }

  p {
    margin: 0.7rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  @media (min-width: 80rem) {
    .command-example {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 2rem;
    }

    .command-reference {
      margin-top: 0;
    }
  }
</style>
