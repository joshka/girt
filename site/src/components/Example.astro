---
// A CLI example with its command reference: the girt command, the nearest Git command and the
// library items it calls, in that order. Inline, the reference is a strip above the example; in the margin layout it
// is a card beside the example that moves under it when the column is too narrow for both.
import { calls } from '../data/cli-calls';

interface Props {
  /** Key into `calls` in `src/data/cli-calls.ts`, usually the command name. */
  cmd: string;
  /** One sentence on how the girt and Git commands differ, when that helps. */
  note?: string;
  /**
   * `inline` (the default) puts a compact strip between the section heading and the example;
   * `margin` hangs a card beside the example and needs the page's table of contents turned off.
   */
  layout?: 'margin' | 'inline';
}

const { cmd, note, layout = 'inline' } = Astro.props;
const entry = calls[cmd];
if (!entry) throw new Error(`no CLI calls entry for "${cmd}"`);
const { api, git } = entry;
const command = entry.command ?? `girt ${cmd}`;
const docs = 'https://docs.rs/girt/latest/girt/';

// Each comma-separated Git form links to its git-scm.com page; a form without its own `git <name>`
// (such as `--list` after `git config --get`) belongs to the command before it.
let gitCommand = '';
const gitForms = (git ?? '').split(', ').filter(Boolean).map((text) => {
  const name = /^git ([a-z-]+)/.exec(text)?.[1];
  if (name) gitCommand = name;
  return { text, href: `https://git-scm.com/docs/git-${gitCommand}` };
});
---

<div class:list={['girt-example', { inline: layout === 'inline' }]}>
  <div class="grid">
    <div class="body"><slot /></div>
    <aside class="reference not-content" aria-label={`Command reference: ${command}`}>
      <p class="title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6v12m12-12v2a4 4 0 0 1-4 4h-4a4 4 0 0 0-4 4"></path>
          <circle cx="6" cy="4" r="2"></circle>
          <circle cx="18" cy="4" r="2"></circle>
          <circle cx="6" cy="20" r="2"></circle>
        </svg>
        <span>Command reference</span>
      </p>
      <dl>
        <div>
          <dt>girt command</dt>
          <dd><code>{command}</code></dd>
        </div>
        {
          git && (
            <div>
              <dt>Git equivalent</dt>
              <dd>
                <ul class="forms">
                  {
                    gitForms.map(({ text, href }) => (
                      <li>
                        <a href={href}>
                          <code>{text}</code>
                          <span aria-hidden="true"> ↗</span>
                          <span class="sr-only"> (external)</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Library API</dt>
          <dd>
            <ul>
              {
                api.map(([label, path]) => (
                  <li>
                    <a href={path.startsWith('https://') ? path : docs + path}>
                      <code>{label}</code>
                      <span aria-hidden="true"> ↗</span>
                      <span class="sr-only"> (external)</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
      {note && <p class="note">{note}</p>}
    </aside>
  </div>
</div>

<style>
  .girt-example {
    container-type: inline-size;
    margin-block: 1.5rem;
  }

  .body {
    min-width: 0;
  }

  .body > :global(:first-child) {
    margin-top: 0;
  }

  .reference {
    min-width: 0;
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    background: var(--sl-color-gray-6);
    color: var(--girt-text-secondary);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font: 600 0.6875rem/1.5 var(--__sl-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  svg {
    flex: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  dl {
    margin: 0.9rem 0 0;
  }

  dl > div + div {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  dt {
    margin-bottom: 0.15rem;
    color: var(--sl-color-gray-3);
    font: 0.6875rem/1.5 var(--__sl-font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--sl-color-text);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  code {
    padding: 0;
    background: none;
    color: var(--sl-color-white);
    font: 0.75rem/1.6 var(--__sl-font-mono);
    overflow-wrap: anywhere;
    white-space: normal;
  }

  a {
    text-decoration: underline 1.5px var(--girt-underline);
    text-underline-offset: 4px;
  }

  /* Inline-block keeps the arrow out of the link underline. */
  a span[aria-hidden] {
    display: inline-block;
    margin-left: 0.15em;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 4px;
  }

  .note {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  /* Narrow: the card sits under the example with each label beside its value. */
  @container (max-width: 59.99rem) {
    dl > div {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: 1rem;
      align-items: baseline;
    }

    dt {
      margin: 0;
    }

    ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1.25rem;
    }
  }

  /* Wide: the card sits beside the prose and code, its top level with the example's. */
  @container (min-width: 60rem) {
    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 2rem;
      align-items: start;
    }

    .reference {
      margin-top: 0;
    }
  }

  /* Inline: a compact strip between the heading and the example. */
  .inline .grid {
    display: flex;
    flex-direction: column-reverse;
  }

  .inline .reference {
    margin: 0 0 1rem;
    padding: 0.6rem 0.9rem;
  }

  .inline .title {
    display: none;
  }

  .inline dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.2rem 1rem;
    align-items: baseline;
    margin: 0;
  }

  .inline dl > div,
  .inline dl > div + div {
    display: contents;
  }

  .inline dt {
    margin: 0;
    white-space: nowrap;
  }

  .forms {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }

  .inline ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }
</style>
