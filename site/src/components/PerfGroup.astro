---
// One frequency group of the jj benchmark: operations × repository sizes, coloured by band.
import {
  ISSUES_URL,
  SIZES,
  bandLabels,
  formatMs,
  formatRatio,
  operationLabel,
  operationsFor,
  sizeLabel,
  type FrequencyGroup,
} from '../data/jj-performance';

interface Props {
  group: FrequencyGroup;
}

const { group } = Astro.props;
const operations = operationsFor(group);
const labels = bandLabels(group);
const blameText = {
  girt: 'girt',
  jj: 'jj',
  boundary: 'near bound',
};
const blameTitle = {
  girt: 'girt is at least 20% slower than stock jj',
  jj: 'stock jj is slow here too',
  boundary: 'stock jj is just inside the band; girt is less than 20% slower',
};
---

<p>{group.description}</p>
<div class="perf-legend" aria-label={`${group.title} bands`}>
  {
    labels.map((label, band) => (
      <span class={`perf-chip band-${band}`}>{label}</span>
    ))
  }
</div>
<div class="perf-scroll" tabindex="0" role="region" aria-label={`${group.title} benchmark table`}>
  <table class="perf-table">
    <caption class="sr-only">
      {group.title}: jj with girt compared with stock jj, by repository size
    </caption>
    <thead>
      <tr>
        <th scope="col">Operation</th>
        {SIZES.map((size) => <th scope="col">{sizeLabel(size)}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        operations.map((operation) => (
          <tr>
            <th scope="row">
              <code>{operationLabel(operation)}</code>
              {operation.workload && <span class="perf-workload">{operation.workload}</span>}
            </th>
            {SIZES.map((size) => {
              const cell = operation.cells[size];
              if (!cell) return <td class="perf-empty">not measured</td>;
              const { row } = cell;
              const stock = row.stock_ms == null ? 'stock jj failed' : `stock ${formatMs(row.stock_ms)}`;
              const git = row.git_ms == null ? null : `Git ${formatMs(row.git_ms)}`;
              const issues = row.issues ?? [];
              return (
                <td>
                  {cell.outcome === 'ok' ? (
                    <span class={`perf-chip band-${cell.girtBand}`}>
                      {formatMs(row.girt_ms!)}
                      <span class="sr-only"> (band {labels[cell.girtBand!]})</span>
                    </span>
                  ) : (
                    <span class="perf-chip perf-failed">
                      {cell.outcome === 'timeout'
                        ? `timed out${row.timeout_limits_s?.girt ? ` at ${formatMs(row.timeout_limits_s.girt * 1000)}` : ''}`
                        : cell.outcome === 'refused'
                          ? 'refused'
                          : 'no result'}
                    </span>
                  )}
                  <span class="perf-detail">
                    {stock}
                    {row.ratio_vs_stock != null && <> · {formatRatio(row.ratio_vs_stock)}</>}
                  </span>
                  {git && <span class="perf-detail perf-git">{git}</span>}
                  {cell.workload.length > 0 && (
                    <span class="perf-detail perf-git">{cell.workload.join('; ')}</span>
                  )}
                  {(cell.blame.length > 0 || issues.length > 0) && (
                    <span class="perf-tags">
                      {cell.blame.map((blame) => (
                        <span class={`perf-tag tag-${blame}`} title={blameTitle[blame]}>
                          {blameText[blame]}
                        </span>
                      ))}
                      {issues.map((issue) => (
                        <a class="perf-issue" href={`${ISSUES_URL}${issue}`}>
                          #{issue}
                        </a>
                      ))}
                    </span>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
