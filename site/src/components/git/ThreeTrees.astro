---
import Figure from './Figure.astro';
---

<Figure caption="Status compares HEAD with the index (staged changes) and the index with the working directory (unstaged changes). git add copies working files into the index; git commit turns the index into a commit.">
  <svg viewBox="0 0 640 190" role="img" aria-labelledby="three-trees-title">
    <title id="three-trees-title">
      Three boxes: HEAD's tree, the index and the working directory. Between HEAD and the index is
      the staged diff; between the index and the working directory is the unstaged diff.
    </title>
    <defs>
      <marker id="tt-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrow" d="M0,0 L8,4 L0,8 z" />
      </marker>
    </defs>
    <rect class="box" x="20" y="40" width="160" height="70" rx="8" />
    <text x="100" y="68" text-anchor="middle">HEAD's tree</text>
    <text class="muted" x="100" y="90" text-anchor="middle">last commit</text>
    <rect class="box-accent" x="240" y="40" width="160" height="70" rx="8" />
    <text x="320" y="68" text-anchor="middle">index</text>
    <text class="muted" x="320" y="90" text-anchor="middle">.git/index</text>
    <rect class="box" x="460" y="40" width="160" height="70" rx="8" />
    <text x="540" y="68" text-anchor="middle">working directory</text>
    <text class="muted" x="540" y="90" text-anchor="middle">files on disk</text>
    <text class="label" x="210" y="24" text-anchor="middle">STAGED</text>
    <text class="label" x="430" y="24" text-anchor="middle">UNSTAGED</text>
    <path class="edge" d="M210 30 V 120" stroke-dasharray="3 4" />
    <path class="edge" d="M430 30 V 120" stroke-dasharray="3 4" />
    <path class="edge-strong" d="M540 120 C 540 160 320 160 320 116" marker-end="url(#tt-arrow)" />
    <text class="muted" x="430" y="172" text-anchor="middle">git add</text>
    <path class="edge-strong" d="M320 120 C 300 170 100 170 100 116" marker-end="url(#tt-arrow)" />
    <text class="muted" x="200" y="180" text-anchor="middle">git commit</text>
  </svg>
</Figure>
