---
import Figure from './Figure.astro';
---

<Figure caption="A branch names a commit. Each commit names a tree and its parent; trees name blobs and subtrees. The second commit reuses the unchanged README blob and docs tree.">
  <svg viewBox="0 0 640 300" role="img" aria-labelledby="object-graph-title">
    <title id="object-graph-title">
      refs/heads/main points at commit c2, whose parent is c1. Each commit points at a root tree.
      The two root trees share the README blob and the docs tree but point at different lib.rs blobs.
    </title>
    <defs>
      <marker id="og-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="arrow" d="M0,0 L8,4 L0,8 z" />
      </marker>
    </defs>
    <g class="edges">
      <path class="edge-strong" d="M440 32 V 50" marker-end="url(#og-arrow)" />
      <path class="edge-strong" d="M380 70 H 196" marker-end="url(#og-arrow)" />
      <path class="edge" d="M140 92 V 128" marker-end="url(#og-arrow)" />
      <path class="edge" d="M440 92 V 128" marker-end="url(#og-arrow)" />
      <path class="edge" d="M110 170 L 70 228" marker-end="url(#og-arrow)" />
      <path class="edge" d="M150 170 L 220 228" marker-end="url(#og-arrow)" />
      <path class="edge" d="M170 170 L 365 228" marker-end="url(#og-arrow)" />
      <path class="edge" d="M410 170 L 240 228" marker-end="url(#og-arrow)" />
      <path class="edge" d="M430 170 L 385 228" marker-end="url(#og-arrow)" />
      <path class="edge" d="M470 170 L 545 228" marker-end="url(#og-arrow)" />
    </g>
    <text class="label" x="20" y="22">REF</text>
    <rect class="box-accent" x="370" y="4" width="140" height="28" rx="6" />
    <text x="440" y="22" text-anchor="middle">refs/heads/main</text>
    <text class="label" x="20" y="78">COMMITS</text>
    <rect class="box" x="90" y="52" width="100" height="40" rx="6" />
    <text x="140" y="70" text-anchor="middle">commit c1</text>
    <text class="muted" x="140" y="85" text-anchor="middle">no parent</text>
    <rect class="box" x="390" y="52" width="100" height="40" rx="6" />
    <text x="440" y="70" text-anchor="middle">commit c2</text>
    <text class="muted" x="440" y="85" text-anchor="middle">parent c1</text>
    <text class="label" x="20" y="156">TREES</text>
    <rect class="box" x="90" y="132" width="100" height="36" rx="6" />
    <text x="140" y="155" text-anchor="middle">tree /</text>
    <rect class="box" x="390" y="132" width="100" height="36" rx="6" />
    <text x="440" y="155" text-anchor="middle">tree /</text>
    <text class="label" x="20" y="252">BLOBS</text>
    <rect class="box-quiet" x="20" y="232" width="100" height="36" rx="6" />
    <text x="70" y="255" text-anchor="middle">lib.rs v1</text>
    <rect class="box-quiet" x="180" y="232" width="100" height="36" rx="6" />
    <text x="230" y="255" text-anchor="middle">README</text>
    <rect class="box" x="330" y="232" width="100" height="36" rx="6" />
    <text x="380" y="255" text-anchor="middle">tree docs/</text>
    <rect class="box-quiet" x="500" y="232" width="100" height="36" rx="6" />
    <text x="550" y="255" text-anchor="middle">lib.rs v2</text>
  </svg>
</Figure>
