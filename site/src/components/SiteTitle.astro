---
// The wordmark: the name set in the heading face. There is no logo yet (see DESIGN.md).
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title girt-wordmark" translate="no">{siteTitle}</a>

<style>
  .girt-wordmark {
    color: var(--sl-color-white);
    font-family: var(--girt-font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
